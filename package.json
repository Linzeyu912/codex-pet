{
  "name": "codex-pet",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm assets:prepare && tauri dev",
    "dev:web": "vite --host 127.0.0.1 --port 1420",
    "build": "pnpm release:gate",
    "build:web": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "dev:tauri": "pnpm dev",
    "build:desktop": "pnpm build:tauri",
    "build:tauri": "node scripts/build-desktop.mjs",
    "tauri": "tauri",
    "assets:build": "node scripts/build-local-assets.mjs",
    "assets:prepare": "node scripts/prepare-local-assets.mjs",
    "assets:validate": "pnpm assets:prepare && powershell -NoProfile -File windows/Validate-CodexAtlas.ps1",
    "assets:continuity": "node scripts/check-animation-continuity.mjs",
    "assets:install": "node scripts/install-codex-pet.mjs",
    "assets:uninstall": "node scripts/uninstall-codex-pet.mjs",
    "version:check": "node scripts/check-version-sync.mjs",
    "verify": "node scripts/verify-project.mjs",
    "verify:ci": "node scripts/verify-project.mjs --ci --with-tauri --release",
    "release:gate": "node scripts/verify-project.mjs --release",
    "release:check": "node scripts/check-public-release.mjs",
    "state": "node scripts/set-state.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-autostart": "2.5.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "sharp": "0.35.3",
    "typescript": "7.0.2",
    "vite": "8.1.4"
  },
  "packageManager": "pnpm@11.9.0"
}
